# Convex Configuration
# Get your Convex URL from your Convex dashboard
# Format: https://your-deployment-name.convex.cloud
CONVEX_URL=https://your-deployment-name.convex.cloud

# Authentication Options (choose one):

# Option 1: Service Token (recommended for server-to-server)
# Get this from your Convex dashboard under Settings > Service Tokens
# CONVEX_AUTH_TOKEN=your-service-token-here

# Option 2: Email/Password (for Convex Auth with Password provider)
# Use your existing user credentials
CONVEX_AUTH_EMAIL=your.email@example.com
CONVEX_AUTH_PASSWORD=your-password

# Turning this variable on will enable verbose logging
# MCP_DEBUG=1


# This is the absolute path of your claude_desktop_config.json, which is used by Claude Desktop
CLAUDE_DESKTOP_CONFIG_PATH=/Users/example/Library/Application Support/Claude/claude_desktop_config.json